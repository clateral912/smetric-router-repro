+            max_tree_size: 1 << 20,
+        }))
+    }
+
+    async fn route(app: axum::Router, text: &str) -> (StatusCode, String, String) {
+        let payload = json!({"text": text, "stream": false});
+        let request = Request::builder()
+            .method("POST")
+            .uri("/generate")
+            .header(CONTENT_TYPE, "application/json")
+            .body(Body::from(serde_json::to_vec(&payload).unwrap()))
+            .unwrap();
+        let response = app.oneshot(request).await.unwrap();
+        let status = response.status();
+        let policy = response
+            .headers()
+            .get("x-policy-decision")
+            .unwrap()
+            .to_str()
+            .unwrap()
+            .to_string();
+        let worker = response
+            .headers()
+            .get("x-routed-instance")
+            .unwrap()
+            .to_str()
+            .unwrap()
+            .to_string();
+        let _ = axum::body::to_bytes(response.into_body(), usize::MAX)
+            .await
+            .unwrap();
+        (status, policy, worker)
+    }
+
+    #[tokio::test]
+    async fn native_smetric_routes_and_reuses_prefix_home() {
+        let mut config = RouterConfig::new(
+            RoutingMode::Regular {
+                worker_urls: vec![],
+            },
+            policy_config(),
+        );
+        config.worker_startup_timeout_secs = 2;
+        config.worker_startup_check_interval_secs = 1;
+        let ctx = TestContext::new_with_config(
