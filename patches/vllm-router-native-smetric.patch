+        if self.completed.swap(true, Ordering::AcqRel) {
+            return;
+        }
+        self.policy.on_request_complete(
+            &self.worker_url,
+            Some(self.reservation_id),
+            success,
+            self.started_at.elapsed(),
+        );
+    }
+}
+
+impl Drop for PolicyRequestLifecycle {
+    fn drop(&mut self) {
+        // A handler future can be cancelled before it reaches an explicit
+        // completion path. Releasing here keeps policy-owned work from
+        // becoming permanent; complete() is idempotent for normal paths.
+        self.complete(false);
+    }
+}
