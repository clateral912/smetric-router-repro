             PromptInput::IntArray(ids) => {
-                // Convert token IDs to string representation for routing
-                // Format: "token_ids:<count>" to indicate this is a token-based prompt
-                format!("token_ids:{}", ids.len())
+                // Benchmark input adapter: one Unicode scalar per token for
+                // ordinary model vocabularies. This preserves token-prefix
+                // lengths in the existing character-based tree. The prompt
+                // forwarded to the engine remains the original integer array.
+                let mut key = String::new();
+                for &id in ids {
+                    if (0..=0x10f7fe).contains(&id) {
+                        let scalar = id as u32 + if id >= 0xd800 { 0x800 } else { 0 };
+                        key.push(char::from_u32(scalar).unwrap());
+                    } else {
+                        // Reserve the last scalar as an escape for IDs outside
+                        // that vocabulary range; do not collapse distinct IDs.
+                        key.push('\u{10ffff}');
+                        key.push_str(&format!("{id:08x}"));
+                    }
+                }
+                key
             }
