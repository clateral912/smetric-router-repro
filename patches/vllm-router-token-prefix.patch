@@ -2408,6 +2422,47 @@ mod tests {
     use super::*;
     use serde_json;
 
+    #[test]
+    fn token_prompt_adapter_preserves_prefix_and_payload() {
+        let ids = vec![0, 0xd7ff, 0xd800, 151644, 198];
+        let prompt = PromptInput::IntArray(ids.clone());
+        let key = prompt.extract_text_for_routing();
+        assert_eq!(key.chars().count(), ids.len());
+        assert_eq!(
+            serde_json::to_value(&prompt).unwrap(),
+            serde_json::json!(ids)
+        );
+        let continuation = PromptInput::IntArray(vec![0, 0xd7ff, 0xd800, 151644, 199]);
+        let other = continuation.extract_text_for_routing();
+        assert_eq!(
+            key.chars()
+                .zip(other.chars())
+                .take_while(|(a, b)| a == b)
+                .count(),
+            4
+        );
+        assert_ne!(key, other);
+        let tree = crate::tree::Tree::new();
+        tree.insert(&key, "worker-a");
+        let matched = tree.prefix_match_with_counts(&other);
+        assert_eq!(matched.matched_char_count, 4);
+        assert_eq!(matched.input_char_count, 5);
+        assert_eq!(matched.tenant.as_ref(), "worker-a");
+    }
+
+    #[test]
+    fn token_prompt_adapter_keeps_text_behavior() {
+        assert_eq!(
+            PromptInput::String("abc".into()).extract_text_for_routing(),
+            "abc"
+        );
+        assert_eq!(PromptInput::IntArray(vec![]).extract_text_for_routing(), "");
+        assert_ne!(
+            PromptInput::IntArray(vec![-1]).extract_text_for_routing(),
+            PromptInput::IntArray(vec![0x10f7ff]).extract_text_for_routing()
+        );
+    }
