 logger = init_logger(__name__)
 
 
+# SSCHED_ES_START
+import json as _es_json
+import os as _es_os
+import threading as _es_threading
+import time as _es_time
+
+_ES_URL = _es_os.environ.get("SSCHED_REDIS_URL", "")
+_ES_ID = _es_os.environ.get("SSCHED_ENGINE_ID",
+                            f"engine_{_es_os.getpid()}")
+_ES_PERIOD_S = float(_es_os.environ.get("SSCHED_STATE_PERIOD_MS", "50")) / 1000.0
+_ES_TTL_MS = 5000
+_ES_SCHEMA_VERSION = 3  # EngineState v3 (ssched.state.schema)
+
+
+def _es_kv_bytes_per_token(scheduler) -> int:
+    """KV bytes per token for kvstore byte accounting.
+
+    Derived at first use from the engine's own kv_cache_config
+    (sum over groups: layers x page_size_bytes / block_size), so it
+    tracks whatever model this engine is serving. SSCHED_KV_BYTES_PER_TOKEN
+    overrides; the Qwen3-Coder-30B geometry (96 KiB) is the last resort.
+    """
+    cached = getattr(scheduler, "_es_kv_bpt", None)
+    if cached is not None:
+        return cached
+    env = _es_os.environ.get("SSCHED_KV_BYTES_PER_TOKEN")
+    if env:
+        value = int(env)
+    else:
+        value = 0
+        try:
+            for group in scheduler.kv_cache_config.kv_cache_groups:
+                spec = group.kv_cache_spec
+                value += (len(group.layer_names)
+                          * int(spec.page_size_bytes) // int(spec.block_size))
+        except Exception:
+            value = 0
+        if value <= 0:
+            value = 98304
+    try:
+        scheduler._es_kv_bpt = value
+    except Exception:
+        pass
+    return value
+
+
+def _es_decode_state(scheduler) -> dict:
+    state = getattr(scheduler, "_es_decode_state", None)
+    if not isinstance(state, dict):
+        state = {"last_by_req": {}, "gap_ema_s": 0.0, "gap_max_s": 0.0}
+        try:
+            scheduler._es_decode_state = state
+        except Exception:
+            pass
+    return state
+
+
+def _es_note_kvstore_reads(scheduler, scheduled_new_reqs):
+    """Accumulate global-store READ traffic: each newly scheduled request
+    carries num_external_computed_tokens (the store share of its prefix
+    hit, set by the patched scheduler); tokens x KV-bytes/token is the
+    volume fetched from the store. WRITE traffic needs a store-side
+    (LMCache/Mooncake) patch and stays 0 until that lands."""
+    try:
+        ext_tokens = 0
+        for r in scheduled_new_reqs:
+            ext = getattr(r, "num_external_computed_tokens", None)
+            if ext is None:
+                rid = getattr(r, "request_id", None) or getattr(r, "req_id", None)
+                req = scheduler.requests.get(rid) if rid else None
+                ext = getattr(req, "num_external_computed_tokens", 0) if req else 0
+            ext_tokens += int(ext or 0)
+        if ext_tokens:
+            scheduler._es_kvstore_read_bytes = (
+                int(getattr(scheduler, "_es_kvstore_read_bytes", 0))
+                + ext_tokens * _es_kv_bytes_per_token(scheduler))
+    except Exception:
+        pass
+
+
+def _es_inflight(scheduler):
+    ledger = getattr(scheduler, "_es_inflight_tokens", None)
+    if ledger is None:
+        ledger = {}
+        scheduler._es_inflight_tokens = ledger
+    return ledger
+
+
+def _es_output_hook(scheduler, update):
+    def completed(*args, **kwargs):
+        output = args[0] if args else kwargs["scheduler_output"]
+        try:
+            return update(*args, **kwargs)
+        finally:
+            ledger = _es_inflight(scheduler)
+            for rid, count in output.num_scheduled_tokens.items():
+                remaining = ledger.get(rid, 0) - int(count)
+                if remaining > 0:
+                    ledger[rid] = remaining
+                else:
+                    ledger.pop(rid, None)
+            _es_publish_now(scheduler)
+    return completed
+
+
+def _es_note_decode(scheduler, scheduled_timestamp, num_scheduled_tokens,
+                    scheduled_new_reqs, scheduled_resumed_reqs):
+    """Track per-request decode service cadence from one scheduler step."""
+    _es_note_kvstore_reads(scheduler, scheduled_new_reqs)
+    ledger = _es_inflight(scheduler)
+    for rid, count in num_scheduled_tokens.items():
+        ledger[rid] = ledger.get(rid, 0) + int(count)
+    try:
+        state = _es_decode_state(scheduler)
+        last_by_req = state["last_by_req"]
+        new_ids = {r.request_id for r in scheduled_new_reqs}
+        resumed_ids = {r.request_id for r in scheduled_resumed_reqs}
+        alpha = 0.2
+        for rid, n in num_scheduled_tokens.items():
+            if rid in new_ids or rid in resumed_ids or int(n) > 1:
+                continue
+            prev = last_by_req.get(rid)
+            if prev is not None:
+                gap = max(0.0, float(scheduled_timestamp) - float(prev))
+                state["gap_max_s"] = max(float(state["gap_max_s"]), gap)
+                old = float(state["gap_ema_s"])
+                state["gap_ema_s"] = gap if old <= 0.0 else (
+                    old * (1.0 - alpha) + gap * alpha)
+            last_by_req[rid] = float(scheduled_timestamp)
+        running_ids = {getattr(r, "request_id", None)
+                       for r in scheduler.running}
+        for rid in list(last_by_req):
+            if rid not in running_ids:
+                last_by_req.pop(rid, None)
+    except Exception:
+        pass
+
+
+def _es_snapshot(scheduler) -> dict:
+    """Cheap O(batch) EngineState v3 payload from the live scheduler."""
+    try:
+        pool = scheduler.kv_cache_manager.block_pool
+        total = int(pool.num_gpu_blocks)
+        free = int(pool.get_num_free_blocks())
+    except Exception:
+        total = free = 0
+    n_run = pend = dec = n_dec = n_pref = max_pref = 0
+    active_decode_ids = []
+    inflight = _es_inflight(scheduler)
+    try:
+        for r in scheduler.running:
+            n_run += 1
+            npr = int(getattr(r, "num_prompt_tokens", 0))
+            nct = max(0, int(getattr(r, "num_computed_tokens", 0))
+                      - inflight.get(r.request_id, 0))
+            nout = int(getattr(r, "num_output_tokens",
+                              max(0, int(getattr(r, "num_tokens", npr)) - npr)))
+            if nct < npr or nout == 0:
+                rem = max(0, npr - nct)
+                pend += rem
+                n_pref += 1
+                max_pref = max(max_pref, rem)
+            else:
+                limit = getattr(r, "max_tokens", None)
+                if limit is not None and nout >= limit:
+                    continue
+                dec += int(getattr(r, "num_tokens", 0))
+                n_dec += 1
+                rid = getattr(r, "request_id", None)
+                if rid is not None:
+                    active_decode_ids.append(rid)
+    except Exception:
+        pass
+    n_wait = 0
+    try:
+        n_wait = len(scheduler.waiting) + len(
+            getattr(scheduler, "skipped_waiting", []))
+        for r in list(scheduler.waiting):
+            pend += max(0, int(getattr(r, "num_prompt_tokens", 0))
+                        - max(0, int(getattr(r, "num_computed_tokens", 0))
+                              - inflight.get(r.request_id, 0)))
+    except Exception:
+        pass
+
+    state = _es_decode_state(scheduler)
+    now_m = _es_time.monotonic()
+    active_gap_max = 0.0
+    for rid in active_decode_ids:
+        last = state["last_by_req"].get(rid)
+        if last is not None:
+            active_gap_max = max(active_gap_max,
+                                 max(0.0, now_m - float(last)))
+
+    return {
+        "schema_version": _ES_SCHEMA_VERSION,
+        "engine_id": _ES_ID,
+        "ts": _es_time.time(),
+        "num_running": n_run,
+        "num_waiting": int(n_wait),
+        "gpu_blocks_total": total,
+        "gpu_blocks_free": free,
+        "gpu_kv_used_frac": ((total - free) / total) if total > 0 else 0.0,
+        "pending_prefill_tokens": int(pend),
+        "ongoing_decode_tokens": int(dec),
+        "num_prefilling": n_pref,
+        "max_prefill_remaining": int(max_pref),
+        "decode_active_requests": n_dec,
+        "decode_service_active_gap_max_s": active_gap_max,
+        "decode_service_gap_ema_s": float(state["gap_ema_s"]),
+        "decode_service_gap_max_s": float(state["gap_max_s"]),
+        "kvstore_read_bytes_total": int(
+            getattr(scheduler, "_es_kvstore_read_bytes", 0)),
+        "kvstore_write_bytes_total": int(
+            getattr(scheduler, "_es_kvstore_write_bytes", 0)),
+    }
+
+
+class _ESPublisher:
+    def __init__(self, scheduler):
+        import redis as _redis  # engine venv dependency
+        self._sched = scheduler
+        self._redis = _redis.Redis.from_url(_ES_URL)
+        self._key = f"engine_state:{_ES_ID}"
+        self._lock = _es_threading.Lock()
+        self._last = 0.0
+        self._t = _es_threading.Thread(target=self._loop, daemon=True)
+        self._t.start()
+
+    def publish_now(self):
+        try:
+            with self._lock:
+                self._last = _es_time.monotonic()
+                self._redis.set(self._key,
+                                _es_json.dumps(_es_snapshot(self._sched)),
+                                px=_ES_TTL_MS)
+        except Exception:
+            pass
+
+    def _loop(self):
+        while True:
+            _es_time.sleep(_ES_PERIOD_S)
+            if _es_time.monotonic() - self._last >= _ES_PERIOD_S:
+                self.publish_now()
+
+
+def _es_publish_now(scheduler):
+    try:
+        publisher = getattr(scheduler, "_es_publisher", None)
+        if publisher is not None:
+            publisher.publish_now()
+    except Exception:
+        pass
+# SSCHED_ES_END
+
