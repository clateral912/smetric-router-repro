+    def _agentic_request_needs_decode_token(self, request: Request) -> bool:
+        if request.num_computed_tokens < request.num_prompt_tokens:
+            return False
+        if (
+            request.num_output_placeholders > 0
+            and request.num_computed_tokens + 2 - request.num_output_placeholders
+            >= request.num_prompt_tokens + request.max_tokens
+        ):
+            return False
+        pending_tokens = (
+            request.num_tokens_with_spec
+            + request.num_output_placeholders
+            - request.num_computed_tokens
+        )
+        return pending_tokens > 0 and request.num_computed_tokens < (
+            self.max_model_len - 1
+        )
+
+    def _agentic_decode_reserve_after(self, req_index: int, token_budget: int) -> int:
+        if not self._agentic_decode_token_reservation or token_budget <= 0:
+            return 0
+        reserve = 0
+        for request in self.running[req_index + 1:]:
+            if self._agentic_request_needs_decode_token(request):
+                reserve += 1
+                if reserve >= token_budget:
+                    break
+        return reserve
+
+    def _agentic_has_decode_ready_after(self, req_index: int) -> bool:
+        if not self._agentic_decode_first_no_mix:
+            return False
+        return any(
+            self._agentic_request_needs_decode_token(request)
+            for request in self.running[req_index + 1:]
+        )
